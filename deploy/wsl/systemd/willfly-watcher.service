[Unit]
Description=Willfly restart-safe learning watcher tick
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/willfly/willfly.env
ExecStart=/bin/bash %h/.local/share/willfly/bin/run-service.sh watcher
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=512M
CPUQuota=100%
TimeoutStartSec=2min
