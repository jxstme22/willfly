[Unit]
Description=Willfly bounded read-only chain capture pass
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/willfly/willfly.env

[Service]
Type=oneshot
EnvironmentFile=%h/.config/willfly/willfly.env
ExecStart=/bin/bash %h/.local/share/willfly/bin/run-service.sh capture
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=1G
CPUQuota=100%
TimeoutStartSec=10min
