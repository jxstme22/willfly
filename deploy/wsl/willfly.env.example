# Willfly WSL2 operator environment.
#
# This file is shell-compatible and is read by systemd user units. Keep it
# private (chmod 600). It contains paths and bounded run settings only. Do not
# put wallet keys, RPC tokens, or other credentials here; this release has no
# signer or broadcast path.

# The installer replaces these three values in a newly-created env file.
WILLFLY_PROJECT_DIR=/path/to/willfly
WILLFLY_VENV=/home/user/.local/share/willfly/venv
WILLFLY_STATE_DIR=/home/user/.local/state/willfly

WILLFLY_PYTHON=/home/user/.local/share/willfly/venv/bin/python
WILLFLY_BIN=/home/user/.local/share/willfly/venv/bin/willfly
WILLFLY_LOG_DIR=/home/user/.local/state/willfly/logs
WILLFLY_LOG_MAX_BYTES=10485760
WILLFLY_LOG_BACKUPS=5

WILLFLY_SOURCE_CONFIG=/path/to/willfly/configs/sources/robinhood-chain-v0.1.json
WILLFLY_WATCHER_CONFIG=/path/to/willfly/configs/learning/watcher-v0.1.json
WILLFLY_PIPELINE_CONFIG=/path/to/willfly/configs/learning/pipeline-v0.1.json
WILLFLY_SHADOW_CONFIG=/path/to/willfly/configs/shadow/config.json

WILLFLY_OBSERVATORY_DIR=/home/user/.local/state/willfly/observatory
WILLFLY_FEEDBACK_DIR=/home/user/.local/state/willfly/feedback
WILLFLY_WATCHER_DB=/home/user/.local/state/willfly/watcher.sqlite3
WILLFLY_PIPELINE_STATE_DB=/home/user/.local/state/willfly/pipeline.sqlite3
WILLFLY_SHADOW_DB=/home/user/.local/state/willfly/shadow.sqlite3
WILLFLY_MODEL_REGISTRY=/home/user/.local/state/willfly/models.sqlite3
WILLFLY_INITIAL_ACTIVE_VERSION=

# Capture defaults to a checkpointed rolling backfill pass. Set a recent,
# explicit starting block before starting the capture timer. The guard prevents
# an accidental unbounded historical scan on a public RPC endpoint.
WILLFLY_CAPTURE_MODE=rolling_backfill
WILLFLY_CAPTURE_START_BLOCK=
WILLFLY_CAPTURE_MAX_BLOCKS=500
WILLFLY_CAPTURE_PAGE_SIZE=250
WILLFLY_CAPTURE_CONFIRMATION_LAG=12
WILLFLY_CAPTURE_SOURCE=live-readonly

# Dashboard binds to loopback. Change this only when deliberately configuring
# a firewall and LAN access.
WILLFLY_DASHBOARD_HOST=127.0.0.1
WILLFLY_DASHBOARD_PORT=8000
WILLFLY_SIGNALS_FILE=/home/user/.local/state/willfly/pipeline/signals-latest.json

# Candidate training is waiting until a corpus or both feature/partition maps
# are supplied. A training report is written atomically under this directory.
WILLFLY_TRAIN_MANIFEST=/path/to/willfly/configs/connectome/male-cns-v1.0.json
WILLFLY_TRAIN_DATA_ROOT=/home/user/.local/state/willfly/connectome
WILLFLY_TRAIN_CORPUS=
WILLFLY_TRAIN_FEATURES=
WILLFLY_TRAIN_PARTITIONS=
WILLFLY_TRAIN_AS_OF_TIME=
WILLFLY_TRAIN_MAX_EDGES=100000
WILLFLY_TRAIN_PARTITION_INDEX=1
WILLFLY_TRAIN_PARTITION_COUNT=4
WILLFLY_TRAIN_SEEDS=7,17,27
WILLFLY_TRAIN_MAX_EXAMPLES=100000
WILLFLY_TRAIN_REPORT_DIR=/home/user/.local/state/willfly/training
WILLFLY_TRAIN_LATEST_REPORT=/home/user/.local/state/willfly/training/candidate-latest.json
WILLFLY_TRAIN_CHECKPOINT_DIR=/home/user/.local/state/willfly/training/checkpoints

# Forward candidate evaluation is separately scheduled and never promotes a
# model. Leave inputs empty until a versioned points bundle and dataset hash
# exist. Set WILLFLY_EVALUATION_RECORD=1 only to record a qualified report in
# the explicitly supplied local registry; promotion remains a manual command.
WILLFLY_EVALUATION_POINTS=
WILLFLY_EVALUATION_CANDIDATE_VERSION=
WILLFLY_EVALUATION_ACTIVE_VERSION=
WILLFLY_EVALUATION_DATASET_HASH=
WILLFLY_EVALUATION_AS_OF_TIME=
WILLFLY_EVALUATION_MIN_WINDOWS=2
WILLFLY_EVALUATION_MIN_POINTS=2
WILLFLY_EVALUATION_RECORD=0
WILLFLY_EVALUATION_REPORT_DIR=/home/user/.local/state/willfly/evaluation
WILLFLY_EVALUATION_LATEST_REPORT=/home/user/.local/state/willfly/evaluation/evaluation-latest.json

# Shadow evaluation consumes an operator-produced, versioned observation file.
# It remains waiting until the config is frozen and the input exists.
WILLFLY_SHADOW_INPUT=
WILLFLY_SHADOW_FIXED_ENTRY_ATOMIC=50
WILLFLY_SHADOW_INITIAL_CASH_ATOMIC=100
WILLFLY_SHADOW_MAX_POSITIONS=3

# Set these only after reviewing the watcher config. Empty values use the
# library's waiting state and do not invent stage evidence.
WILLFLY_WATCHER_OBSERVATION_STATE=waiting
WILLFLY_WATCHER_TRAINING_STATE=waiting
WILLFLY_WATCHER_EVALUATION_STATE=waiting
